<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9E1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find Your Next Job"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="16dp"/>

            <!-- Job 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#F7E08B">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Senior Full Stack Developer" android:textStyle="bold" android:textSize="18sp" android:textColor="#000000"/>
                    <Button android:id="@+id/btnApply1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apply Now" android:backgroundTint="#FFB300" android:textColor="#000000" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Job 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#F7E08B">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Solutions Engineer" android:textStyle="bold" android:textSize="18sp" android:textColor="#000000"/>
                    <Button android:id="@+id/btnApply2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apply Now" android:backgroundTint="#FFB300" android:textColor="#000000" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Job 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#F7E08B">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apple iOS Developer" android:textStyle="bold" android:textSize="18sp" android:textColor="#000000"/>
                    <Button android:id="@+id/btnApply3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apply Now" android:backgroundTint="#FFB300" android:textColor="#000000" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Job 4 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#F7E08B">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data Analyst" android:textStyle="bold" android:textSize="18sp" android:textColor="#000000"/>
                    <Button android:id="@+id/btnApply4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apply Now" android:backgroundTint="#FFB300" android:textColor="#000000" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Job 5 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#F7E08B">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Android Developer" android:textStyle="bold" android:textSize="18sp" android:textColor="#000000"/>
                    <Button android:id="@+id/btnApply5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apply Now" android:backgroundTint="#FFB300" android:textColor="#000000" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Job 6 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#F7E08B">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Social Media Manager" android:textStyle="bold" android:textSize="18sp" android:textColor="#000000"/>
                    <Button android:id="@+id/btnApply6" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apply Now" android:backgroundTint="#FFB300" android:textColor="#000000" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Job 7 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#F7E08B">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IT Support Specialist" android:textStyle="bold" android:textSize="18sp" android:textColor="#000000"/>
                    <Button android:id="@+id/btnApply7" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apply Now" android:backgroundTint="#FFB300" android:textColor="#000000" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:background="#F7E08B"
        android:orientation="horizontal"
        android:weightSum="3"
        android:elevation="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textColor="#333333"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navFindJob"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Find Job"
            android:textColor="#FFB300"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#333333"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>