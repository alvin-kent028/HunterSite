<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9E1"
    tools:ignore="HardcodedText">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <View
                android:id="@+id/topBanner"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#FFF9E1"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/editProfileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                android:layout_marginTop="80dp"
                app:cardCornerRadius="25dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#F7E08B"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECRUITER EDIT MODE"
                        android:textColor="#FFB300"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:padding="10dp"
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:textSize="16sp"/>
                    <EditText
                        android:id="@+id/etEditRecruiterName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Your Name"
                        android:background="@android:color/transparent"
                        android:paddingVertical="8dp"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:inputType="textPersonName"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Professional Title"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:textColor="#333333"
                        android:textSize="16sp"/>
                    <EditText
                        android:id="@+id/etEditRecruiterTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Senior Talent Acquisition"
                        android:background="@android:color/transparent"
                        android:paddingVertical="8dp"
                        android:textSize="15sp"
                        android:textColor="#FFB300"
                        android:inputType="textPersonName"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Company Name"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:textColor="#333333"
                        android:textSize="16sp"/>
                    <EditText
                        android:id="@+id/etEditCompanyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="LeapFroggr Inc."
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Business Email"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:textColor="#333333"
                        android:textSize="16sp"/>
                    <EditText
                        android:id="@+id/etEditBusinessEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g @gmail.com"
                        android:inputType="textEmailAddress"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hiring Focus Areas"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:layout_marginTop="18dp"/>
                    <EditText
                        android:id="@+id/etEditHiringFocus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Tech, Design, Marketing"
                        android:textSize="15sp"
                        android:textColor="#666666"/>

                    <Button
                        android:id="@+id/btnSaveRecruiterChanges"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:text="Update Profile"
                        android:textAllCaps="false"
                        android:backgroundTint="#FFB300"
                        android:textColor="#000000"
                        android:layout_marginTop="32dp"
                        app:cornerRadius="25dp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btnCancelRecruiterEdit"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:text="Discard Changes"
                        android:textAllCaps="false"
                        android:backgroundTint="#EEEEEE"
                        android:textColor="#333333"
                        android:layout_marginTop="10dp"
                        app:cornerRadius="25dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="40dp"
                app:cardElevation="12dp"
                app:layout_constraintTop_toTopOf="@id/editProfileCard"
                app:layout_constraintBottom_toTopOf="@id/editProfileCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_camera"
                    android:padding="15dp"
                    android:background="#F7E08B"
                    app:tint="#333333"/>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:background="#F7E08B"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textColor="#FFB300"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navFindJob"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Posted Jobs"
            android:textColor="#333333"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#333333"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
